# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────

# ── External PostgreSQL ───────────────────────────────────────────
# Example: jdbc:postgresql://your-db-host:5432/travelhub
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/YOUR_DB_NAME
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# ── Email (Gmail SMTP) ────────────────────────────────────────────
MAIL_USERNAME=triphivetours@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ── TripJack API ──────────────────────────────────────────────────
TRIPJACK_API_KEY=6128195cb95765-02c3-4c40-a3d2-d4e8ed294ab0

# ── Feature Flags ─────────────────────────────────────────────────
# Set to true to use mock data instead of live TripJack API
MOCK_ENABLED=false
